# Production environment configuration
# Copy to ../.env and fill in values before deploying

# ── Database (use strong password in production) ──────
DB_USERNAME=realityai
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Anthropic API ────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# ── LangSmith ───────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=CHANGE_ME
LANGSMITH_PROJECT=realityai-agents-prod

# ── Redis ────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── ChromaDB ─────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ── gRPC ─────────────────────────────────────────────
GRPC_TARGET=core-service:9090
GRPC_TIMEOUT=10

# ── JWT (generate with: openssl rand -hex 32) ───────
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Rate Limiting ───────────────────────────────────
RATE_LIMIT_RPM=30
