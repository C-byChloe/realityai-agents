# ── Database ──────────────────────────────────────────
DB_USERNAME=realityai
DB_PASSWORD=realityai

# ── Anthropic API ────────────────────────────────────
ANTHROPIC_API_KEY=your-api-key-here

# ── LangSmith (optional) ────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=realityai-agents

# ── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── ChromaDB ─────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8100

# ── gRPC Core Service ───────────────────────────────
GRPC_TARGET=localhost:9090
GRPC_TIMEOUT=10

# ── JWT Authentication ──────────────────────────────
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Rate Limiting ───────────────────────────────────
RATE_LIMIT_RPM=60
